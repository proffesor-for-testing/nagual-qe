# Nagual Environment Configuration
# Copy this file to .env and customize for your environment
#
# IMPORTANT: Never commit .env files with real credentials to version control!

# ============================================================================
# PostgreSQL Configuration
# ============================================================================

# PostgreSQL connection settings
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nagual
POSTGRES_USER=nagual
POSTGRES_PASSWORD=change_me_dev_only

# SSL mode: disable, prefer, require, verify-ca, verify-full
POSTGRES_SSLMODE=prefer

# Optional: Schema to use (defaults to "public")
# POSTGRES_SCHEMA=nagual

# ============================================================================
# Docker Compose Configuration
# ============================================================================

# Port mappings (change if defaults conflict with other services)
# POSTGRES_PORT=5432
# PGADMIN_PORT=5050

# pgAdmin credentials (only needed if using 'admin' profile)
PGADMIN_EMAIL=admin@nagual.local
PGADMIN_PASSWORD=admin

# ============================================================================
# Connection Pool Configuration
# ============================================================================

# Maximum connections in pool
DATABASE_POOL_MAX=10

# Minimum connections to maintain
DATABASE_POOL_MIN=1

# Connection acquire timeout (seconds)
DATABASE_POOL_TIMEOUT=30

# ============================================================================
# Application Configuration
# ============================================================================

# Log level: trace, debug, info, warn, error
RUST_LOG=info

# Enable backtrace for debugging
RUST_BACKTRACE=1

# ============================================================================
# TLS Configuration (for production)
# ============================================================================

# Path to CA certificate
# POSTGRES_CA_CERT=/path/to/ca.pem

# Path to client certificate (for mutual TLS)
# POSTGRES_CLIENT_CERT=/path/to/client.pem

# Path to client key (for mutual TLS)
# POSTGRES_CLIENT_KEY=/path/to/client.key
